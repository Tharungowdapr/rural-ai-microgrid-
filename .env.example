# Rural AI Microgrid — Environment Configuration
# Copy this file to .env and adjust as needed.

# Comma-separated allowed CORS origins (frontend origin)
CORS_ORIGINS=http://localhost:3000

# WebSocket broadcast interval in seconds
WS_BROADCAST_INTERVAL_SEC=2.0

# Paths to LSTM model artifacts (relative to backend/ or absolute)
MODEL_PATH=../lstm_model.h5
SCALER_PATH=ml/scaler.joblib
METRICS_PATH=ml/metrics.json

# SQLite database URL
DATABASE_URL=sqlite:///./microgrid.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
